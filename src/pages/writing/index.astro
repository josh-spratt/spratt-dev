---
import Page from "../../layouts/Page.astro";
import { site, getPosts, formatDate } from "../../lib/site";

const posts = await getPosts();
---

<Page
  title={`Writing — ${site.name}`}
  description={`Writing by ${site.name}.`}>
  <h1>Writing</h1>
  <ul class="post-list">
    {
      posts.map((p) => (
        <li data-has-image={p.data.image ? "" : undefined}>
          {p.data.image && <img class="logo" src={p.data.image} alt="" width="64" height="64" loading="lazy" />}
          <a href={`/writing/${p.id}/`}>{p.data.title}</a>
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          <p>{p.data.description}</p>
        </li>
      ))
    }
  </ul>
</Page>
