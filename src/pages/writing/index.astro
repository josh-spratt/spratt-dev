---
import Handheld from "../../layouts/Handheld.astro";
import { site, getPosts, formatDate } from "../../lib/site";

const posts = await getPosts();
---

<Handheld
  title={`Writing — ${site.name}`}
  description={`Writing by ${site.name}.`}
  readout={`Done · ${posts.length} ${posts.length === 1 ? "post" : "posts"}`}>
  <h1>Writing</h1>
  <ul class="post-list">
    {
      posts.map((p) => (
        <li>
          <a href={`/writing/${p.id}/`}>{p.data.title}</a>
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          <p>{p.data.description}</p>
        </li>
      ))
    }
  </ul>
</Handheld>
