---
import { render } from "astro:content";
import Page from "../../layouts/Page.astro";
import { site, getPosts, formatDate } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, image } = post.data;
---

<Page title={`${title} — ${site.name}`} description={description} type="article">
  <article class="post">
    <header class:list={["post-head", { "has-cover": image }]}>
      {image && <img class="cover" src={image} alt="" width="160" height="160" />}
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          updated && (
            <>
              {" · Updated "}
              <time data-updated datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </>
          )
        }
        {/* Filled in by the Worker with " · Read N times" (worker/index.ts). */}
        <span data-stats></span>
      </p>
    </header>
    <Content />
    {/* A plain form: the Worker handles the POST and fills in the label (worker/index.ts). */}
    <form class="like" method="post" action={`/writing/${post.id}/like`}>
      <button type="submit"><span aria-hidden="true">♥</span> <span data-like-label>Like</span></button>
    </form>
  </article>
</Page>
