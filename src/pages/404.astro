---
import { site } from "../lib/site";
import Page from "../layouts/Page.astro";
---

<Page title={`Not found — ${site.name}`} noindex>
  <div class="not-found">
    <span class="warning-icon" data-icon="warning" aria-hidden="true"></span>
    <p>That page doesn't exist</p>
    <a class="key" href="/">Go home</a>
  </div>
</Page>
