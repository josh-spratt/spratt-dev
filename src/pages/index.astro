---
import { site, projects, getPosts, formatDate } from "../lib/site";
import Page from "../layouts/Page.astro";

const posts = await getPosts();
const recent = posts.slice(0, 3);
---

<Page title={`${site.name} — ${site.role}`} description={site.description} home>
  <section class="intro" aria-label="Intro">
    <h1 data-name>{site.name}</h1>
    <p class="role">{site.role}</p>
    <p class="bio">{site.bio}</p>
  </section>
  <section aria-labelledby="projects">
    <h2 id="projects">Projects</h2>
    <ul class="rows">
      {
        projects.map((p) => (
          <li>
            <a href={p.url}>
              {p.image ? (
                <img class="logo" src={p.image} alt="" width="64" height="64" loading="lazy" />
              ) : (
                <span class="logo" aria-hidden="true" />
              )}
              <span class="body">
                <strong>{p.title}</strong>
                <span class="detail">{p.description}</span>
                {p.tags && (
                  <span class="meta">
                    {p.tags.map((t) => (
                      <span data-tag>{t}</span>
                    ))}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  {
    recent.length > 0 && (
      <section class="recent-writing" aria-labelledby="recent-writing">
        <h2 id="recent-writing">Recent writing</h2>
        <ul class="rows">
          {recent.map((p) => (
            <li>
              <a href={`/writing/${p.id}/`}>
                {p.data.image ? (
                  <img class="logo" src={p.data.image} alt="" width="64" height="64" loading="lazy" />
                ) : (
                  <span class="logo" aria-hidden="true" />
                )}
                <span class="body">
                  <strong>{p.data.title}</strong>
                  <span class="detail">{p.data.description}</span>
                  <span class="meta">
                    <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        {posts.length > recent.length && (
          <p class="more">
            <a href="/writing/">All writing →</a>
          </p>
        )}
      </section>
    )
  }
</Page>
