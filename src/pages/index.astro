---
import { site, projects, getPosts, formatDate } from "../lib/site";
import Handheld from "../layouts/Handheld.astro";

const recent = (await getPosts()).slice(0, 3);
const projectCount = `${projects.length} ${projects.length === 1 ? "project" : "projects"}`;
---

<Handheld title={`${site.name} — ${site.role}`} description={site.description} home readout={`Done · ${projectCount}`}>
  <p class="role">{site.role}</p>
  <p class="bio">{site.bio}</p>
  <section aria-labelledby="projects">
    <h2 id="projects">Projects</h2>
    <ul class="rows">
      {
        projects.map((p) => (
          <li>
            <a href={p.url} data-has-image={p.image ? "" : undefined}>
              {p.image && <img class="logo" src={p.image} alt="" width="88" height="88" loading="lazy" />}
              <strong>{p.title}</strong>
              <span class="detail">
                {p.description}
                {p.tags && (
                  <span class="tags">
                    {p.tags.map((t) => (
                      <span data-tag>{t}</span>
                    ))}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  {
    recent.length > 0 && (
      <section class="recent-writing" aria-labelledby="recent-writing">
        <h2 id="recent-writing">Recent writing</h2>
        <ul class="rows">
          {recent.map((p) => (
            <li>
              <a href={`/writing/${p.id}/`} data-has-image={p.data.image ? "" : undefined}>
                {p.data.image && <img class="logo" src={p.data.image} alt="" width="88" height="88" loading="lazy" />}
                <strong>{p.data.title}</strong>
                <span class="detail">
                  {p.data.description}
                  <span class="tags">
                    <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Handheld>
