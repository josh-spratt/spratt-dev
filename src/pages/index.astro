---
import { site, projects, games, getPosts, formatDate } from "../lib/site";
import Page from "../layouts/Page.astro";
import Tags from "../components/Tags.astro";
import GameCards from "../components/GameCards.astro";

const posts = await getPosts();
const recent = posts.slice(0, 3);
// The Games page lists them all; the Homepage shows the first three, like Recent writing.
---

<Page title={site.name} description={site.description} home>
  <section class="intro" aria-label="Intro" slot="hero">
    <h1 data-name>{site.name}</h1>
    <span class="stack" data-chrome aria-hidden="true">
      <span class="brick b1"></span>
      <span class="brick b2"></span>
      <span class="brick b3"></span>
    </span>
    <p class="role">{site.role}</p>
    <p class="bio">{site.bio}</p>
  </section>
  {
    recent.length > 0 && (
      <section class="recent-writing" aria-labelledby="recent-writing">
        <h2 id="recent-writing">Recent writing</h2>
        <ul class="rows posts">
          {recent.map((p) => (
            <li>
              <a href={`/writing/${p.id}/`}>
                {p.data.image ? (
                  <img class="logo" src={p.data.image} alt="" width="64" height="64" loading="lazy" />
                ) : (
                  <span class="logo" aria-hidden="true" />
                )}
                <span class="body">
                  <strong>{p.data.title}</strong>
                  <span class="detail">{p.data.description}</span>
                  <span class="meta">
                    <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  </span>
                  <Tags tags={p.data.tags} />
                </span>
              </a>
            </li>
          ))}
        </ul>
        {posts.length > recent.length && (
          <p class="more">
            <a href="/writing/">All writing</a>
          </p>
        )}
      </section>
    )
  }
  {
    games.length > 0 && (
      <section class="games-block" aria-labelledby="games">
        <h2 id="games">Games</h2>
        <GameCards games={games.slice(0, 3)} />
        {games.length > 3 && (
          <p class="more">
            <a href="/games/">All games</a>
          </p>
        )}
      </section>
    )
  }
  <section aria-labelledby="projects">
    <h2 id="projects">Projects</h2>
    <ul class="rows">
      {
        projects.map((p) => (
          <li>
            <a href={p.url}>
              {p.image ? (
                <img class="logo" src={p.image} alt="" width="64" height="64" loading="lazy" />
              ) : (
                <span class="logo" aria-hidden="true" />
              )}
              <span class="body">
                <strong>{p.title}</strong>
                <span class="detail">{p.description}</span>
                <Tags tags={p.tags} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Page>
