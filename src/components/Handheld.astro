---
/* The handheld, as a picture beside the name. Nothing in it is a control.
   On load, the bricks on its screen drop in and stack themselves, once. */
---

<div class="device" data-chrome aria-hidden="true">
  <span class="device-led"></span>
  <div class="device-bezel">
    <div class="device-screen">
      <span class="brick b1"></span>
      <span class="brick b2"></span>
      <span class="brick b3"></span>
      <span class="brick b4"></span>
    </div>
  </div>
  <span class="device-word">Spratt</span>
  <span class="device-dpad"></span>
  <span class="device-ab"><b></b><b></b></span>
  <span class="device-speaker"></span>
</div>
