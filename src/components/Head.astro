---
import { buildMode, site, siteUrl } from "../lib/site";
import FeedLink from "./FeedLink.astro";
import "../styles/global.css";

interface Props {
  /** Full document title, e.g. "Writing — Josh Spratt". */
  title: string;
  description?: string;
  type?: "website" | "article";
  noindex?: boolean;
  /** Share card, a path under public/ such as /cards/slug.png. Defaults to /social.png. */
  image?: string;
  imageAlt?: string;
  /** Post dates, for article:published_time and article:modified_time. */
  published?: Date;
  modified?: Date;
}

const { title, description, type = "website", noindex = false, published, modified } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const image = `${siteUrl}${Astro.props.image ?? "/social.png"}`;
const imageAlt = Astro.props.image ? (Astro.props.imageAlt ?? title) : `${site.name} — ${site.role}`;
const beacon =
  buildMode === "production" && site.analyticsToken
    ? JSON.stringify({ token: site.analyticsToken })
    : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="theme-color" content="#f2c230" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" sizes="32x32" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:type" content={type} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<FeedLink />
{beacon && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={beacon}
  ></script>
)}
