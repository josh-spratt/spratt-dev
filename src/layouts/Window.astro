---
import Head from "../components/Head.astro";
interface Props {
  title: string;
  description?: string;
  /** Document title; defaults to the title-bar text. */
  pageTitle?: string;
  type?: "website" | "article";
  status?: string;
}
const { title, description, pageTitle = title, type, status = "Done" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={pageTitle} description={description} type={type} />
  </head>
  <body>
    <div class="desktop">
      <div class="window">
        <div class="title-bar" data-chrome="title" aria-hidden="true">
          <span class="buttons">
            <i data-button="close"></i><i data-button="minimize"></i><i data-button="zoom"></i>
          </span>
          {title}
        </div>
        <main class="content"><slot /></main>
        <div class="status-bar" data-chrome="status" aria-hidden="true">
          <span>{status}</span>
        </div>
      </div>
    </div>
  </body>
</html>
