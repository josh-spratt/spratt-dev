{
  "compilerOptions": {
    "target": "es2024",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // The Worker imports the game's own scoreOf (public/games/cactus-boats/score.js).
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
