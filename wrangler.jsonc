{
	// Static build output, plus a small Worker script that runs for every page of
	// the site to record its Views as Events in D1 (and, for /writing/*, the old
	// Post counts), for a Game's event address to log Plays and Finishes, for
	// /out/* to record Click outs, and for /stats* to serve the private traffic
	// dashboard (see worker/index.ts). Every other path (CSS, images, a Game's
	// files) is served straight from the assets without running the script. The
	// dashboard sits behind Cloudflare Access and needs the ACCESS_TEAM_DOMAIN and
	// ACCESS_AUD secrets (docs/database.md); without them /stats/ is a 404.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spratt-dev",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	// Production lives on the apex Custom Domain only; branch previews keep their URLs.
	// Set here because `wrangler deploy` re-applies these on every deploy.
	"workers_dev": false,
	"preview_urls": true,
	// Workers Builds runs `wrangler preview` (open beta) on non-main branches,
	// which refuses to run without this block. Previews get only the bindings
	// listed here, not the top-level ones, so DB is repeated. Previews read the
	// live counts but never write them (the Worker checks the hostname).
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "spratt-dev",
				"database_id": "b398c392-0df0-411b-a720-3813a07e3a3f"
			}
		]
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Every built page must be listed, or its Views aren't recorded; a test checks.
		"run_worker_first": [
			"/",
			"/games/",
			"/writing/*",
			"/privacy/",
			"/games/twenty-boats/",
			"/games/twenty-boats/event",
			"/games/cactus-boats/",
			"/games/cactus-boats/event",
			// Cactus Boats' Leaderboard: a run id, a Score, and the board.
			"/games/cactus-boats/start",
			"/games/cactus-boats/score",
			"/games/cactus-boats/scores",
			// Click outs: /out/<name>/ records it and redirects.
			"/out/*",
			"/stats",
			"/stats/*"
		]
	},
	// Daily at 03:17 UTC: strip Visitor ids from Events older than 13 months
	// (the Worker's scheduled handler). Free plans include cron triggers.
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	// Create once with `npx wrangler d1 create spratt-dev`; see docs/database.md.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "spratt-dev",
			"database_id": "b398c392-0df0-411b-a720-3813a07e3a3f",
			"migrations_dir": "migrations"
		}
	]
}