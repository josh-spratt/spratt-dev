{
	// Static build output, plus a small Worker script that runs only for /writing/*
	// to count Views in D1 (see worker/index.ts). Every other path is served
	// straight from the assets without running the script.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spratt-dev",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	// Production lives on the apex Custom Domain only; branch previews keep their URLs.
	// Set here because `wrangler deploy` re-applies these on every deploy.
	"workers_dev": false,
	"preview_urls": true,
	// Workers Builds runs `wrangler preview` (open beta) on non-main branches,
	// which refuses to run without this block. Empty means "inherit everything".
	"previews": {},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/writing/*"
		]
	},
	// Create once with `npx wrangler d1 create spratt-dev`; see docs/database.md.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "spratt-dev",
			"database_id": "b398c392-0df0-411b-a720-3813a07e3a3f",
			"migrations_dir": "migrations"
		}
	]
}