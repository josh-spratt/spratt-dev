{
	// Static build output, plus a small Worker script that runs only for /writing/*
	// to count Views in D1, for a Game's page and its event address to log Views,
	// Plays and Finishes, and for /stats* to serve the private traffic dashboard
	// (see worker/index.ts). Every other path is served straight from the assets
	// without running the script. The dashboard needs the STATS_KEY secret
	// (`npx wrangler secret put STATS_KEY`); without it /stats/ is a 404.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spratt-dev",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	// Production lives on the apex Custom Domain only; branch previews keep their URLs.
	// Set here because `wrangler deploy` re-applies these on every deploy.
	"workers_dev": false,
	"preview_urls": true,
	// Workers Builds runs `wrangler preview` (open beta) on non-main branches,
	// which refuses to run without this block. Previews get only the bindings
	// listed here, not the top-level ones, so DB is repeated. Previews read the
	// live counts but never write them (the Worker checks the hostname).
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "spratt-dev",
				"database_id": "b398c392-0df0-411b-a720-3813a07e3a3f"
			}
		]
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/writing/*",
			"/games/twenty-boats/",
			"/games/twenty-boats/event",
			"/games/cactus-boats/",
			"/games/cactus-boats/event",
			"/stats",
			"/stats/*"
		]
	},
	// Create once with `npx wrangler d1 create spratt-dev`; see docs/database.md.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "spratt-dev",
			"database_id": "b398c392-0df0-411b-a720-3813a07e3a3f",
			"migrations_dir": "migrations"
		}
	]
}